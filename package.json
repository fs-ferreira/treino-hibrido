{
  "name": "treino-hibrido",
  "version": "7.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:movements": "playwright test movement-browser.spec.mjs",
    "test:ui": "playwright test duration-browser.spec.mjs cross-plans-browser.spec.mjs exercise-card-browser.spec.mjs muscle-map-browser.spec.mjs text-browser.spec.mjs forearm-browser.spec.mjs flexible-browser.spec.mjs field-controls-browser.spec.mjs workout-lifecycle-browser.spec.mjs heart-rate-browser.spec.mjs run-presentation-browser.spec.mjs --output=test-results/ui",
    "preview:movements": "node scripts/preview-movements.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:auth": "playwright test auth-browser.spec.mjs --output=test-results/auth",
    "test:compat": "playwright test --config=playwright.compat.config.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "lucide-static": "1.61.0",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "pg": "8.16.3"
  },
  "engines": {
    "node": "24.x"
  }
}
